# 测试环境的非敏感配置（纳入版本管理）。密钥由 GitHub 的 test 环境 secrets 在部署时追加。
DEPLOY_ENV=test
GATEWAY_PORT=8000
SEED_DEMO=true
STUB_CLIENTS=false
# 启动 Mailpit 收件箱；通知邮件全部发到这里，界面只绑定服务器本机，经 SSH 隧道查看：
#   ssh -L 8025:127.0.0.1:8025 <部署用户>@<测试机>
COMPOSE_PROFILES=mailcatcher
MAIL_UI_PORT=127.0.0.1:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
