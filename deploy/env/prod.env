# 生产环境的非敏感配置（纳入版本管理）。密钥由 GitHub 的 production 环境 secrets 在部署时追加。
DEPLOY_ENV=prod
GATEWAY_PORT=8000
SEED_DEMO=false
STUB_CLIENTS=false
# 邮件：SMTP_HOST 为空表示不发邮件，通知只保留站内信。接入学校/云服务商的 SMTP 后填写下面几项，
# 并在 production 环境 secrets 中设置 SMTP_PASSWORD（.env.example 中默认留空的项）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
MAIL_FROM=noreply@campus.local
